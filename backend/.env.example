# LifeSync AI - Backend Environment Configuration Template

# The primary database connection string.
# For local development, use SQLite:
DATABASE_URL=sqlite:///./sql_app.db
# For production, use PostgreSQL (e.g. postgresql://user:password@localhost/dbname)
# DATABASE_URL=

# Secret key for signing JWT tokens. 
# Generate a secure key in production (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowable Origins for CORS (Comma separated)
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production:
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# External API Keys (If integrated in future phases)
AI_API_KEY=your_api_key_here
